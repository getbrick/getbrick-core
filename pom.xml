<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.getbrick</groupId>
        <artifactId>getbrick-build</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath />
    </parent>

    <artifactId>getbrick-ddd-parent</artifactId>
    <packaging>pom</packaging>

    <name>Getbrick DDD</name>
    <description>Getbrick DDD - domain primitives and layering rules, zero framework dependencies</description>
    <url>https://github.com/getbrick/getbrick-ddd</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:getbrick/getbrick-ddd.git</connection>
        <developerConnection>scm:git:git@github.com:getbrick/getbrick-ddd.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/getbrick/getbrick-ddd</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/getbrick/getbrick-ddd/issues</url>
    </issueManagement>

    <properties>
        <!-- Version of the getbrick BOM this repository builds against. -->
        <getbrick.dependencies.version>${project.version}</getbrick.dependencies.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.getbrick</groupId>
                <artifactId>getbrick-dependencies</artifactId>
                <version>${getbrick.dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              内部制品统一在 getbrick-dependencies 里管版本，这里只声明用到的。
              新增 getbrick-* 能力仓库时，在这里加一条无 version 的条目。
            -->
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Test tooling every module shares; declared once, versions from the BOM. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
